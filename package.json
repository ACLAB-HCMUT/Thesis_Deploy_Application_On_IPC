{
  "name": "smart-agriculture",
  "productName": "SmartAgriculture",
  "version": "1.0.0",
   "homepage": "./",
  "main": "public/electron.js",
  "description": "Smart Agriculture application built with Electron and React",
  "scripts": {
  "start": "concurrently \"react-scripts start\" \"wait-on http://localhost:3000 && electron . \"",
  "start:electron": "electron .",
   "build": "react-scripts build",
  "electron:build": "react-scripts build && electron-builder build --win --x64",
  "release": "npm run build && npm run electron:build"
},
  "dependencies": {
    "@mui/material": "^6.1.7",
    "@reduxjs/toolkit": "^2.5.1",
    "axios": "^1.8.1",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "flowbite": "^3.1.2",
    "flowbite-react": "^0.10.2",
    "lucide-react": "^0.473.0",
    "mdb-react-ui-kit": "^9.0.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "^5.0.1",
    "recharts": "^2.13.3",
    "redux-persist": "^6.0.0"
  },
  "build": {
    "appId": "com.example.app",
    "productName": "SmartAgriculture",
    "asar": true,
    "files": [
      "build/**/*",
      "main/**/*",
      "public/**/*",
      "src/**/*"
    ],
    "asarUnpack": [
      "src/assets/image/**/*",
      "main/utils/network.js"
    ],
    "extraResources": [
      "src/assets/image/**/*",
      "main/utils/network.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.2",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^4.9.5",
    "wait-on": "^8.0.2",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}